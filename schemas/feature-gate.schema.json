{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koalapet.invalid/schemas/0.1/feature-gate.schema.json",
  "title": "Feature gate 0.1",
  "type": "object",
  "required": ["id", "feature", "presentation_before_unlock", "all"],
  "properties": {"$schema": {"type": "string"}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*:[a-z][a-z0-9_.-]*$"}, "feature": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}, "presentation_before_unlock": {"enum": ["hidden", "hinted", "locked"]}, "all": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["fact", "operator", "value"], "properties": {"fact": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}, "operator": {"enum": ["eq", "gte", "contains"]}, "value": {}}, "additionalProperties": false}}},
  "additionalProperties": false
}
