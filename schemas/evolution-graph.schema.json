{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koalapet.invalid/schemas/0.1/evolution-graph.schema.json",
  "title": "Evolution graph 0.1",
  "type": "object",
  "required": ["id", "rules"],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"$ref": "#/$defs/id"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "from_form_id", "to_form_id", "priority", "all"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "from_form_id": {"$ref": "#/$defs/id"},
          "to_form_id": {"$ref": "#/$defs/id"},
          "priority": {"type": "integer"},
          "all": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["metric", "operator", "value"],
              "properties": {
                "metric": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
                "operator": {"enum": ["lt", "lte", "eq", "gte", "gt", "contains"]},
                "value": {}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*:[a-z][a-z0-9_.-]*$"}
  },
  "additionalProperties": false
}
