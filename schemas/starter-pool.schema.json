{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koalapet.invalid/schemas/0.1/starter-pool.schema.json",
  "title": "Starter pool 0.1",
  "type": "object",
  "required": ["id", "display_name_key", "egg_ids"],
  "properties": {"$schema": {"type": "string"}, "id": {"$ref": "#/$defs/id"}, "display_name_key": {"type": "string", "minLength": 1}, "egg_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*:[a-z][a-z0-9_.-]*$"}},
  "additionalProperties": false
}
