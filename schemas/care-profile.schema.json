{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koalapet.invalid/schemas/0.1/care-profile.schema.json",
  "title": "Care profile 0.1",
  "type": "object",
  "required": ["id", "display_name_key", "profile_kind", "hatch_duration_seconds", "offline_cap_seconds", "satiety_decay_per_hour", "energy_use_per_hour", "sleep_recovery_per_hour", "hygiene_decay_per_hour", "weight_min_grams", "weight_max_grams", "meal_satiety_bps", "treat_satiety_bps", "meal_mood_bps", "treat_mood_bps", "meal_weight_grams", "treat_weight_grams", "fullness_cap_bps", "digestion_seconds", "max_waste_units", "waste_hygiene_loss_per_hour", "hunger_call_threshold_bps", "tired_call_threshold_bps", "hygiene_call_threshold_bps", "sickness_call_threshold_bps", "call_response_seconds", "severe_hunger_threshold_bps", "illness_dirt_seconds", "illness_hunger_seconds", "illness_probability_bps", "sleep_energy_threshold_bps", "wake_energy_threshold_bps", "sleep_disturbance_bps", "training_energy_cost_bps", "training_effort_gain_bps", "training_mood_gain_bps"],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*:[a-z][a-z0-9_.-]*$"},
    "display_name_key": {"type": "string", "minLength": 1},
    "profile_kind": {"enum": ["standard", "fast_test"]},
    "hatch_duration_seconds": {"type": "integer", "minimum": 1},
    "offline_cap_seconds": {"type": "integer", "minimum": 1},
    "satiety_decay_per_hour": {"type": "integer", "minimum": 0},
    "energy_use_per_hour": {"type": "integer", "minimum": 0},
    "sleep_recovery_per_hour": {"type": "integer", "minimum": 0},
    "hygiene_decay_per_hour": {"type": "integer", "minimum": 0},
    "weight_min_grams": {"type": "integer", "minimum": 1},
    "weight_max_grams": {"type": "integer", "minimum": 1},
    "meal_satiety_bps": {"type": "integer", "minimum": 0},
    "treat_satiety_bps": {"type": "integer", "minimum": 0},
    "meal_mood_bps": {"type": "integer"},
    "treat_mood_bps": {"type": "integer"},
    "meal_weight_grams": {"type": "integer", "minimum": 0},
    "treat_weight_grams": {"type": "integer", "minimum": 0},
    "fullness_cap_bps": {"type": "integer", "minimum": 1, "maximum": 10000},
    "digestion_seconds": {"type": "integer", "minimum": 1},
    "max_waste_units": {"type": "integer", "minimum": 1},
    "waste_hygiene_loss_per_hour": {"type": "integer", "minimum": 0},
    "hunger_call_threshold_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "tired_call_threshold_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "hygiene_call_threshold_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "sickness_call_threshold_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "call_response_seconds": {"type": "integer", "minimum": 1},
    "severe_hunger_threshold_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "illness_dirt_seconds": {"type": "integer", "minimum": 0},
    "illness_hunger_seconds": {"type": "integer", "minimum": 0},
    "illness_probability_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "sleep_energy_threshold_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "wake_energy_threshold_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "sleep_disturbance_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "training_energy_cost_bps": {"type": "integer", "minimum": 0},
    "training_effort_gain_bps": {"type": "integer", "minimum": 0},
    "training_mood_gain_bps": {"type": "integer"}
  },
  "additionalProperties": false
}
