{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koalapet.invalid/schemas/0.1/content-pack-manifest.schema.json",
  "title": "Content pack manifest 0.1",
  "type": "object",
  "required": ["pack_id", "display_name_key", "version", "content_api_version", "type", "authors", "license", "dependencies", "optional_dependencies", "incompatibilities", "load_priority", "base_pack_enabled", "entry_points", "asset_roots", "overrides"],
  "properties": {
    "$schema": {"type": "string"},
    "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "display_name_key": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "content_api_version": {"const": "0.1"},
    "type": {"enum": ["skin", "content", "total_conversion"]},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "license": {"type": "object", "required": ["code", "assets"], "properties": {"code": {"type": "string"}, "assets": {"type": "string"}, "source": {"type": "string"}}, "additionalProperties": false},
    "dependencies": {"$ref": "#/$defs/packRefs"},
    "optional_dependencies": {"$ref": "#/$defs/packRefs"},
    "incompatibilities": {"$ref": "#/$defs/packRefs"},
    "load_priority": {"type": "integer"},
    "base_pack_enabled": {"type": "boolean"},
    "entry_points": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"}},
    "asset_roots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}},
    "overrides": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*:[a-z][a-z0-9_.-]*$"}}
  },
  "$defs": {"packRefs": {"type": "array", "uniqueItems": true, "items": {"type": "object", "required": ["pack_id", "version"], "properties": {"pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}, "version": {"type": "string", "minLength": 1}}, "additionalProperties": false}}},
  "additionalProperties": false
}
